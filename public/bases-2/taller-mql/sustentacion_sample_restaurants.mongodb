// Sustentación del Taller MQL · base de prueba sample_restaurants
// Enunciados:
//   1. Restaurantes italianos de Brooklyn
//   2. Restaurantes por tipo de cocina
//   3. Top 5 de barrios con más restaurantes

/* global use */
// MongoDB Playground
// Use Ctrl+Space inside a snippet or a string literal to trigger completions.

// The current database to use.
//punto1
use("sample_restaurants");

db.restaurants.find({
     cuisine: "Italian", 
    borough:"Brooklyn"},
    {_id:0, name:1,borough:1, cuisine:1, 
    "adress.street":1});



//punto2
use("sample_restaurants");
db.restaurants.aggregate([
  { $group: { _id: "$cuisine", total: { $sum: 1 } } },
  { $project: { _id: 0, cuisine: "$_id", total: 1 } },
  { $sort: { total: -1 } }
]);

//punto3
use("sample_restaurants");
db.restaurants.aggregate([
  { $group: { _id: "$borough", total: { $sum: 1 } } },
  { $project: { _id: 0, borough: "$_id", total: 1 } },
  { $sort: { total: -1 } },
  {$limit: 5}
]);
