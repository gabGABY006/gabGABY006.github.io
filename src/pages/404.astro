---
import CustomImage from '../components/CustomImage.astro';
import siteConfig from '../data/site-config';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" description="Esta página no existe en el portafolio de Gabriella Castro." showHeader={false}>
    <section class="mb-16 flex flex-col items-center text-center sm:mb-24">
        <div class="soft-panel w-full px-6 py-12 sm:px-12 sm:py-16">
            <img src="/stickers/estrella.svg" class="sticker" style="--s:72px;--r:-12deg;top:-28px;left:-6px" alt="" aria-hidden="true" />
            <img src="/stickers/brillo.svg" class="sticker" style="--s:60px;--r:10deg;bottom:-20px;right:-6px" alt="" aria-hidden="true" />
            {
                siteConfig.avatar?.src && (
                    <CustomImage
                        class="mx-auto mb-6 aspect-square w-28 rounded-full border-4 border-[#f472b6] object-cover sm:w-32"
                        {...siteConfig.avatar}
                        loading="eager"
                        width={128}
                        height={128}
                        widths={[128, 256]}
                        sizes="128px"
                    />
                )
            }
            <p class="font-serif text-7xl leading-none text-[#e45ea0] sm:text-8xl dark:text-[#ff9ec9]">404</p>
            <h1 class="mt-4 font-serif text-2xl sm:text-3xl">Ups, esta página no existe</h1>
            <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-main/80">
                Puede que el enlace esté mal escrito o que la página se haya movido. Como un <code>SELECT</code> sin resultados: la consulta corrió, pero no encontró filas.
            </p>
            <div class="mt-8 flex flex-wrap justify-center gap-3">
                <a href="/" class="inline-block rounded-full bg-[#f472b6] px-5 py-2.5 font-semibold text-white no-underline transition hover:-translate-y-0.5">← Volver al inicio</a>
                <a href="/evidencias" class="inline-block rounded-full border border-[#f472b6] px-5 py-2.5 font-semibold text-main no-underline transition hover:-translate-y-0.5">Ver mis evidencias</a>
            </div>
        </div>
    </section>
</BaseLayout>
