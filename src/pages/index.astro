---
import heroImage from '../assets/images/hero.jpg';
import videoIntro from '../assets/images/video_intro.mp4';
import Button from '../components/Button.astro';
import siteConfig from '../data/site-config';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout description={siteConfig.description}>
    <section class="mb-14 sm:mb-20">
        <div class="soft-panel relative overflow-hidden p-3.5 sm:p-5">
            <div class="absolute inset-4 rounded-[1.9rem] border border-main/15 bg-gradient-to-br from-pink-200/20 via-transparent to-pink-300/10" aria-hidden="true" />
            <div class="relative overflow-hidden rounded-[1.5rem] border border-main/20 bg-main/30 shadow-[0_18px_40px_rgba(255,122,176,0.15)]">
                <div class="border-b border-main/20 bg-white/20 px-5 py-5 sm:px-7 sm:py-6">
                    <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.28em] text-main/70">Introducción</p>
                    <p class="max-w-4xl font-serif text-lg leading-relaxed italic text-main sm:text-2xl">
                        Soy Gabriella Michelle Castro Cuello, y también me gusta presentarme como Juan Andrés Orjuela Bello. Actualmente estudio Ingeniería de Sistemas en la Universidad El Bosque, con un interés profundo por la programación y el desarrollo de soluciones que realmente conecten con las personas. Me encanta tejer, crear experiencias visuales, y hacer que la tecnología se vea un poco más linda, más humana y más hermosa. Disfruto del diseño UI, del detalle, y de transformar ideas en interfaces que transmitan emoción, claridad y cariño. Me interesa aprender nuevas tecnologías mientras sigo construyendo proyectos que combinen lógica, creatividad y estilo.
                    </p>
                </div>

                <div id="intro-video-wrap" class="relative aspect-video w-full overflow-hidden">
                    <div class="absolute inset-0 z-0 bg-cover bg-center" style={`background-image: url(${heroImage.src});`} aria-hidden="true" />
                    <div class="absolute inset-0 z-0 bg-gradient-to-t from-[#1e0c18]/75 via-[#1e0c18]/20 to-[#fff7fb]/10" aria-hidden="true" />

                    <div class="absolute inset-x-0 top-0 z-20 flex items-center justify-between p-4 sm:p-5">
                        <span class="inline-flex items-center gap-2 rounded-full border border-white/40 bg-white/15 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.26em] text-white backdrop-blur-sm">
                            <span class="h-2 w-2 rounded-full bg-pink-300" aria-hidden="true" />
                            Video de introducción
                        </span>
                        <button
                            id="play-intro-video"
                            type="button"
                            class="inline-flex items-center justify-center rounded-full border border-white/50 bg-white/20 px-4 py-2 text-sm font-medium text-white shadow-lg backdrop-blur-sm transition hover:scale-[1.02] hover:bg-white/30"
                        >
                            Reproducir
                        </button>
                    </div>

                    <video
                        id="intro-video"
                        class="absolute inset-0 z-10 hidden h-full w-full object-cover"
                        src={videoIntro}
                        playsinline
                        muted
                        loop
                        controls
                    />
                </div>
            </div>
        </div>
    </section>

    <section class="mb-16 sm:mb-24">
        <div class="mb-8 flex items-end justify-between gap-4">
            <div>
                <p class="mb-2 text-xs font-medium uppercase tracking-[0.25em] text-main/70">Explora</p>
                <h2 class="font-serif text-2xl italic sm:text-3xl">Evidencias</h2>
            </div>
        </div>

        <div class="grid gap-4 md:grid-cols-3">
            <a href="/evidencias/personal" class="soft-panel group flex h-full flex-col p-5 text-left no-underline transition hover:-translate-y-1">
                <span class="mb-3 inline-flex w-fit rounded-full border border-main/40 bg-main/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-main/80">Personal</span>
                <h3 class="font-serif text-xl leading-tight text-main">Trabajos más íntimos</h3>
                <p class="mt-2 text-sm leading-relaxed text-main/80">Bocetos, experimentos y piezas creativas que muestran mi proceso personal.</p>
            </a>

            <a href="/evidencias/proyecto" class="soft-panel group flex h-full flex-col p-5 text-left no-underline transition hover:-translate-y-1">
                <span class="mb-3 inline-flex w-fit rounded-full border border-main/40 bg-main/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-main/80">Proyecto</span>
                <h3 class="font-serif text-xl leading-tight text-main">Ideas con propósito</h3>
                <p class="mt-2 text-sm leading-relaxed text-main/80">Diseños y entregas más relevantes de proyectos de diseño y desarrollo.</p>
            </a>

            <a href="/evidencias/clase" class="soft-panel group flex h-full flex-col p-5 text-left no-underline transition hover:-translate-y-1">
                <span class="mb-3 inline-flex w-fit rounded-full border border-main/40 bg-main/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-main/80">Clase</span>
                <h3 class="font-serif text-xl leading-tight text-main">Aprendizajes</h3>
                <p class="mt-2 text-sm leading-relaxed text-main/80">Actividades y ejercicios realizados en clase para seguir creciendo.</p>
            </a>
        </div>

        <div class="mt-8">
            <Button href="/evidencias">Ir a evidencias</Button>
        </div>
    </section>
</BaseLayout>

<script>
    const video = document.getElementById('intro-video');
    const playButton = document.getElementById('play-intro-video');
    const videoWrap = document.getElementById('intro-video-wrap');

    playButton?.addEventListener('click', () => {
        if (!video || !videoWrap) return;

        video.classList.remove('hidden');
        video.classList.add('block');
        video.play().catch(() => undefined);
        playButton.style.display = 'none';
        videoWrap.setAttribute('aria-label', 'Video de introducción en reproducción');
    });
</script>
