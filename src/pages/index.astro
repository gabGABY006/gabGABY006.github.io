---
import heroImage from '../assets/images/hero.jpg';
import videoIntro from '../assets/images/video_intro.mp4';
import Button from '../components/Button.astro';
import siteConfig from '../data/site-config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Números del portafolio: se calculan solos a partir de las páginas de evidencias.
const pages = await getCollection('pages');
const evidencias = pages.filter((p) => /^evidencias\/[^/]+\/[^/]+$/.test(p.id));
const investigaciones = evidencias.filter((p) => p.id.includes('/investigacion-') || p.data.title.startsWith('Investigación'));
const numeros = [
    { valor: evidencias.length, texto: 'evidencias' },
    { valor: investigaciones.length, texto: 'investigaciones' },
    { valor: 3, texto: 'motores de bases de datos' },
    { valor: 1, texto: 'proyecto final' }
];

// Novedades de la página de inicio: para cambiarlas, edita esta lista.
const recientes = [
    { href: '/evidencias/proyecto/bountyline/cierre', img: 'bountyline', tag: 'Proyecto', titulo: 'Cierre de BountyLine', texto: 'Informe ejecutivo y acta de cierre del proyecto final.' },
    { href: '/evidencias/nosql/investigacion-indices-mongodb', img: 'indices-mongodb', tag: 'NoSQL', titulo: 'Índices en MongoDB y la regla ESR', texto: 'Compuestos, multikey, TTL y el orden Equality, Sort, Range.' },
    { href: '/evidencias/plsql/investigacion-paquetes-plsql', img: 'paquetes-plsql', tag: 'PL/SQL', titulo: 'Paquetes en PL/SQL', texto: 'Especificación, cuerpo, sobrecarga y estado del paquete.' }
];
---

<BaseLayout description={siteConfig.description}>
    <section class="mb-14 sm:mb-20">
        <div class="soft-panel relative overflow-hidden p-3.5 sm:p-5">
            <img src="/stickers/mono.svg" class="sticker" style="--s:84px;--r:14deg;top:-34px;right:-6px" alt="" aria-hidden="true" />
            <img src="/stickers/corazon.svg" class="sticker" style="--s:60px;--r:-14deg;bottom:-24px;left:-6px" alt="" aria-hidden="true" />
            <div class="absolute inset-4 rounded-[1.9rem] border border-main/15 bg-gradient-to-br from-pink-200/20 via-transparent to-pink-300/10" aria-hidden="true" />
            <div class="relative overflow-hidden rounded-[1.5rem] border border-main/20 bg-main/30 shadow-[0_18px_40px_rgba(255,122,176,0.15)]">
                <div class="border-b border-main/20 bg-white/20 px-5 py-5 sm:px-7 sm:py-6">
                    <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.28em] text-main/70">Introducción</p>
                    <p class="max-w-4xl font-serif text-lg leading-relaxed italic text-main sm:text-2xl">
                        Soy Gabriella Michelle Castro Cuello. Actualmente estudio Ingeniería de Sistemas en la Universidad El Bosque, con un interés profundo por la programación y el desarrollo de soluciones que realmente conecten con las personas. Me encanta tejer, crear experiencias visuales y hacer que la tecnología se vea un poco más linda, más humana y más hermosa. Disfruto del diseño UI, del detalle y de transformar ideas en interfaces que transmitan emoción, claridad y cariño. Me interesa aprender nuevas tecnologías mientras sigo construyendo proyectos que combinen lógica, creatividad y estilo.
                    </p>
                </div>

                <div id="intro-video-wrap" class="relative aspect-video w-full overflow-hidden">
                    <div class="absolute inset-0 z-0 bg-cover bg-center" style={`background-image: url(${heroImage.src});`} aria-hidden="true" />
                    <div class="absolute inset-0 z-0 bg-gradient-to-t from-[#1e0c18]/75 via-[#1e0c18]/20 to-[#fff7fb]/10" aria-hidden="true" />

                    <div class="absolute inset-x-0 top-0 z-20 flex items-center justify-between p-4 sm:p-5">
                        <span class="inline-flex items-center gap-2 rounded-full border border-white/40 bg-white/15 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.26em] text-white backdrop-blur-sm">
                            <span class="h-2 w-2 rounded-full bg-pink-300" aria-hidden="true" />
                            Video de introducción
                        </span>
                        <button
                            id="play-intro-video"
                            type="button"
                            class="inline-flex items-center justify-center rounded-full border border-[#f7cde4] bg-[#fff4fa]/90 px-4 py-2 text-sm font-bold uppercase tracking-[0.16em] text-[#5a1d3d] shadow-[0_10px_24px_rgba(229,79,149,0.22)] backdrop-blur-sm transition hover:scale-[1.02] hover:bg-[#fffafc] dark:border-[#ff9ec9]/80 dark:bg-[#2c1427]/85 dark:text-[#ffeef7]"
                        >
                            Reproducir
                        </button>
                    </div>

                    <video
                        id="intro-video"
                        class="absolute inset-0 z-10 hidden h-full w-full object-cover"
                        src={videoIntro}
                        playsinline
                        muted
                        loop
                        controls
                    />
                </div>
            </div>
        </div>
    </section>

    <section class="mb-14 sm:mb-20" aria-label="El portafolio en números">
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
            {
                numeros.map((n) => (
                    <div class="soft-panel px-4 py-5 text-center">
                        <p class="font-serif text-4xl leading-none text-[#e45ea0] sm:text-5xl dark:text-[#ff9ec9]">{n.valor}</p>
                        <p class="mt-2 text-xs leading-snug font-semibold uppercase tracking-[0.14em] text-main/75">{n.texto}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <section class="mb-14 sm:mb-20">
        <div class="mb-6">
            <p class="hand-label mb-1">mi proyecto favorito ♡</p>
            <h2 class="font-serif text-2xl italic sm:text-3xl">BountyLine<img src="/stickers/estrella.svg" class="sticker-inline" style="--r:10deg" alt="" aria-hidden="true" /></h2>
        </div>

        <a href="/evidencias/proyecto/bountyline" class="soft-panel group block overflow-hidden p-3.5 no-underline transition hover:-translate-y-1 sm:p-5">
            <img src="/stickers/wow.svg" class="sticker" style="--s:84px;--r:10deg;top:-30px;right:-6px" alt="" aria-hidden="true" />
            <div class="relative overflow-hidden rounded-[1.2rem] border border-main/20">
                <img
                    src="/portadas/bountyline.webp"
                    alt="Pantalla de inicio de sesión de BountyLine"
                    width="1200"
                    height="628"
                    loading="lazy"
                    class="block w-full transition duration-300 group-hover:scale-[1.02]"
                />
            </div>
            <div class="relative px-2 pt-5 pb-2 sm:px-3">
                <div class="mb-3 flex flex-wrap gap-2">
                    <span class="inline-flex rounded-full border border-main/40 bg-main/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-main/80">Proyecto final</span>
                    <span class="inline-flex rounded-full border border-main/40 bg-main/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-main/80">MySQL</span>
                    <span class="inline-flex rounded-full border border-main/40 bg-main/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-main/80">MongoDB</span>
                </div>
                <p class="text-base leading-relaxed text-main/90 sm:text-lg">
                    Un sistema de cazarrecompensas: un jugador publica una misión con recompensa, los cazarrecompensas se postulan y quien la cumple cobra. MySQL maneja los créditos y las misiones (14 tablas, 24 procedimientos, 14 triggers) y MongoDB lo social (publicaciones, chat y bitácora).
                </p>
                <span class="mt-4 inline-block rounded-full bg-[#f472b6] px-5 py-2.5 font-semibold text-white">Ver el proyecto →</span>
            </div>
        </a>
    </section>

    <section class="mb-14 sm:mb-20">
        <div class="mb-6">
            <p class="hand-label mb-1">recién salido del horno</p>
            <h2 class="font-serif text-2xl italic sm:text-3xl">Lo más reciente<img src="/stickers/brillo.svg" class="sticker-inline" style="--r:-8deg" alt="" aria-hidden="true" /></h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
            {
                recientes.map((r) => (
                    <a class="cover-card" href={r.href}>
                        <img src={`/portadas/${r.img}.webp`} alt="" loading="lazy" />
                        <span class="cover-body">
                            <span class="cover-tag">{r.tag}</span>
                            <span class="cover-title">{r.titulo}</span>
                            <span class="cover-text">{r.texto}</span>
                        </span>
                    </a>
                ))
            }
        </div>
    </section>

    <section class="mb-16 sm:mb-24">
        <div class="mb-8 flex items-end justify-between gap-4">
            <div>
                <p class="hand-label mb-1">explora mi trabajo</p>
                <h2 class="font-serif text-2xl italic sm:text-3xl">Evidencias<img src="/stickers/base-datos.svg" class="sticker-inline" style="--r:8deg" alt="" aria-hidden="true" /></h2>
            </div>
        </div>

        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
            <a href="/evidencias/sql" class="soft-panel group flex h-full flex-col p-5 text-left no-underline transition hover:-translate-y-1">
                <span class="mb-3 inline-flex w-fit rounded-full border border-main/40 bg-main/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-main/80">SQL</span>
                <h3 class="font-serif text-xl leading-tight text-main">Consultas y datos</h3>
                <p class="mt-2 text-sm leading-relaxed text-main/80">Ejercicios, consultas y soluciones estructuradas con SQL.</p>
            </a>

            <a href="/evidencias/plsql" class="soft-panel group flex h-full flex-col p-5 text-left no-underline transition hover:-translate-y-1">
                <span class="mb-3 inline-flex w-fit rounded-full border border-main/40 bg-main/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-main/80">PL/SQL Scripts</span>
                <h3 class="font-serif text-xl leading-tight text-main">Procedimientos y lógica</h3>
                <p class="mt-2 text-sm leading-relaxed text-main/80">Scripts, triggers y bloques PL/SQL para automatizar procesos.</p>
            </a>

            <a href="/evidencias/nosql" class="soft-panel group flex h-full flex-col p-5 text-left no-underline transition hover:-translate-y-1">
                <span class="mb-3 inline-flex w-fit rounded-full border border-main/40 bg-main/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-main/80">NoSQL</span>
                <h3 class="font-serif text-xl leading-tight text-main">Modelos flexibles</h3>
                <p class="mt-2 text-sm leading-relaxed text-main/80">Diseños y soluciones orientadas a colecciones, documentos y escalabilidad.</p>
            </a>

            <a href="/evidencias/proyecto" class="soft-panel group flex h-full flex-col p-5 text-left no-underline transition hover:-translate-y-1">
                <span class="mb-3 inline-flex w-fit rounded-full border border-main/40 bg-main/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-main/80">Proyecto</span>
                <h3 class="font-serif text-xl leading-tight text-main">Ideas con propósito</h3>
                <p class="mt-2 text-sm leading-relaxed text-main/80">Entregas y desarrollos relacionados con proyectos de base de datos y software.</p>
            </a>
        </div>

        <div class="mt-8">
            <Button href="/evidencias">Ir a evidencias</Button>
        </div>
    </section>
</BaseLayout>

<script>
    const video = document.getElementById('intro-video');
    const playButton = document.getElementById('play-intro-video');
    const videoWrap = document.getElementById('intro-video-wrap');

    playButton?.addEventListener('click', () => {
        if (!video || !videoWrap) return;

        video.classList.remove('hidden');
        video.classList.add('block');
        video.muted = false;
        video.setAttribute('controls', 'controls');
        video.play().catch(() => undefined);
        playButton.style.display = 'none';
        videoWrap.setAttribute('aria-label', 'Video de introducción en reproducción');
    });
</script>
